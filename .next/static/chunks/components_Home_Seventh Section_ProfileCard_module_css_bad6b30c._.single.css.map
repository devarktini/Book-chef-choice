@import url('https://fonts.googleapis.com/css2?family=Julius+Sans+One&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap');

:root {
  --gap: 2rem;
  --card-radius: 0.5rem;
  --card-img-height: 12rem;
  --container-max: 1200px;
}

.profileSection {
  background-color: #232B2B; /* bg-gray-100 */
  padding-top: 5rem; /* pt-20 */
  padding-bottom: 2.5rem; /* pb-10 */
}
.dark .profileSection {
  background-color: #111827; /* dark:bg-gray-900 */
}

.container {
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 0 1rem; /* px-4 */
}

.cardsGrid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--gap); /* gap-8 */
  
}

@media (min-width: 640px) {
  .cardsGrid {
    grid-template-columns: repeat(2, 1fr); /* sm:grid-cols-2 */
  }
}

@media (min-width: 1024px) {
  .profileSection {
    padding-top: 120px; /* lg:pt-[120px] */
    padding-bottom: 5rem; /* lg:pb-20 */
  }
  .cardsGrid {
    grid-template-columns: repeat(3, 1fr); /* lg:grid-cols-3 */
  }
}

.card {
  margin-bottom: 2.5rem; /* mb-10 */
  overflow: hidden;
  border-radius: var(--card-radius); /* rounded-lg */
  background-color: #151920; /* bg-white */
  box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06); /* shadow-lg */
  transition: box-shadow 300ms ease, transform 300ms ease; /* duration-300 */
}
.dark .card {
  background-color: #2d3748; /* dark:bg-gray-800 */
}
.card:hover {
  box-shadow: 0 20px 40px rgba(2, 6, 23, 0.18); /* hover:shadow-2xl */
}

.cardImage {
  width: 100%;
  height: var(--card-img-height); /* h-48 */
  object-fit: cover;
}

.cardBody {
  padding: 1rem; /* p-4 */
  text-align: center;
}

.cardTitle {
  margin-bottom: 1rem; /* mb-4 */
  font-size:clamp(15px,3vw,25px); /* text-xl */
  font-family: 'Julius Sans One', sans-serif; 
  font-weight: 800; /* font-semibold */
  color: #fc7000; /* text-gray-800 */
}
.dark .cardTitle {
  color: #fc7000; /* dark:text-white */
}

.cardLink {
  color: inherit;
  text-decoration: none;
  transition: color 160ms ease;
}
.cardLink:hover {
  color: #fc7000; /* hover:text-blue-600 */
}
.dark .cardLink:hover {
  color: #FC7000; /* dark:hover:text-blue-400 */
}

.cardDesc {
  margin-bottom: 1.5rem; /* mb-6 */
  color: #ffffff;
  font-size: clamp(13px,4vw,17px);
  font-family: 'Roboto',sans-serif; /* text-gray-600 */
  line-height: 1.4;
}
.dark .cardDesc {
  color: #d1d5db; /* dark:text-gray-300 */
}

.cardButton {
  display: inline-block;
  border-radius: 9999px; /* rounded-full */
  border: 1px solid #d1d5db; /* border-gray-300 */
  padding: 0.5rem 1.5rem; /* py-2 px-6 */
  color: #374151; /* text-gray-700 */
  text-decoration: none;
  transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
}
.cardButton:hover {
  border-color: #2563eb; /* hover:border-blue-600 */
  background-color: #2563eb; /* hover:bg-blue-600 */
  color: #ffffff; /* hover:text-white */
}
.dark .cardButton {
  border-color: #4b5563; /* dark:border-gray-600 */
  color: #d1d5db; /* dark:text-gray-300 */
}
.dark .cardButton:hover {
  background-color: #3b82f6; /* dark:hover:bg-blue-500 */
  border-color: #3b82f6; /* dark:hover:border-blue-500 */
  color: #ffffff;
}
